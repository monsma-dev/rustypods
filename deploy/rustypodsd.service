[Unit]
Description=RustyPods daemon — nspawn pod orchestrator
After=systemd-machined.service
Wants=systemd-machined.service

[Service]
# The uid allowed to drive the daemon besides root; override via
# /etc/rustypods/daemon.env (written by scripts/install-daemon.sh).
Environment=RUSTYPODS_ALLOWED_UID=1000
EnvironmentFile=-/etc/rustypods/daemon.env
ExecStart=/usr/local/bin/rustypodsd --allowed-uid=${RUSTYPODS_ALLOWED_UID}
# Pods live in machine.slice (machined scopes), not in this unit's cgroup.
# nspawn itself is spawned as a daemon child and only reparents to PID 1
# after the daemon exits — KillMode=control-group would SIGKILL that nspawn
# and take the pod down with the daemon. KillMode=process signals only the
# main pid, so pods survive `systemctl restart`. nsenter/exec waiters also
# live in this cgroup and are left behind on purpose; the in-pod payload
# is already in the machine scope (see exec.rs --join-cgroup).
# NEEDS LIVE VERIFICATION on Alma/Debian before calling this settled.
KillMode=process
# The daemon's stop path is a tonic shutdown on SIGTERM. 45s is longer
# than a ~30s drain so systemd does not SIGKILL mid-shutdown.
TimeoutStopSec=45
RuntimeDirectory=rustypods
Restart=on-failure
RestartSec=2
# A crash loop (panic=abort release builds) must not spin forever.
StartLimitIntervalSec=120
StartLimitBurst=5
# nspawn + one exec per pod can hold a lot of fds (ptys, logs, sockets).
LimitNOFILE=1048576

# Hardening that is safe for a root daemon which only supervises nspawn:
# it does not load modules, set the clock, or use realtime scheduling,
# and it is native-arch only.
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
SystemCallArchitectures=native
RemoveIPC=true

# Deliberately NOT set — each one breaks nspawn, binds, or pod payloads.
# NEEDS LIVE VERIFICATION; several were confirmed on a Debian desktop
# (2026-09-20) and must not be "tightened" without a pod boot test.
#   NoNewPrivileges       — PR_SET_NO_NEW_PRIVS is inherited by nspawn and
#                           every pod process, so setuid/file-caps inside
#                           a pod (su, ping, sudo) stop working
#   ProtectKernelTunables — daemon writes /proc/sys ip_forward/route_localnet
#   ProtectControlGroups  — exec path writes cgroup.procs
#   ProtectHome           — desktop pods bind the user's home
#   PrivateTmp            — nspawn resolves --bind sources in the daemon's
#                           mountns, so --bind /tmp would mount a private
#                           tmpfs instead of the host's /tmp (X11 socket)
#   ProtectSystem=strict  — /var/lib/rustypods must stay writable (full is
#                           enough: /usr is read-only, /var stays writable)
#   LockPersonality       — seccomp filter is inherited by nspawn/pod init;
#                           journald/networkd/logind then fail exec with
#                           status=228/SECCOMP
#   RestrictAddressFamilies — the socket() filter is inherited by every pod
#                           process; systemd-networkd can't open AF_PACKET
#                           and host0 never gets an address
#   PrivateMounts         — `ip netns` bind-mounts into /run/netns
#   RestrictSUIDSGID      — breaks su/setuid binaries inside pods
#   UMask=0077            — run dirs must stay 0755 for userns pods

[Install]
WantedBy=multi-user.target
